{
  "expo": {
    "name": "Postervia",
    "slug": "novaku-app",
    "version": "1.4.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": [
      "postervia",
      "app.novaku.mobile"
    ],
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#F67673"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.novaku.mobile",
      "associatedDomains": [
        "applinks:postervia.app"
      ],
      "entitlements": {
        "com.apple.developer.declared-age-range": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram"
        ],
        "_comment_uiscene": "Build 28 (2026-05-25 IOS-LOGIN-106): explicit single-scene UIScene manifest. iOS 26 strictly enforces scene lifecycle (warning: 'UIScene lifecycle will soon be required. Failure to adopt will result in an assert'). Without UIApplicationSceneManifest, SpringBoardUI's SBCrossfadeView fails to find the RCTRootView in expected container during launch-storyboard crossfade -> frame not updated -> white screen.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F67673"
      },
      "edgeToEdgeEnabled": true,
      "package": "app.novaku.mobile",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "postervia.app",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "postervia.app",
              "pathPrefix": "/u"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "./plugins/withAndroidBuildTuning",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-video",
      "react-native-compressor",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F67673",
          "image": "./assets/splash-brand.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "android": {
            "_comment": "IOS-LOGIN-114/116: Android 12+ SplashScreen API renders a centered launch icon, not a full React Native page. The full splash-brand.png wordmark cannot be made identical to BrandIntro here without being shrunk or cropped. Keep the unavoidable native frame as a crisp arch-only mark, then hand off quickly to BrandIntro for the full POSTERVIA + tagline composition.",
            "backgroundColor": "#F67673",
            "image": "./assets/adaptive-icon.png",
            "imageWidth": 288,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#F67673",
              "image": "./assets/adaptive-icon.png"
            }
          },
          "dark": {
            "backgroundColor": "#F67673",
            "image": "./assets/splash-brand.png"
          }
        }
      ],
      "expo-localization",
      [
        "@sentry/react-native",
        {
          "organization": "postervia",
          "project": "postervia-ios",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Postervia to access your camera to scan documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Postervia to access your photos to upload documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Postervia to access your location so it can detect your city and tailor your tasks and Plaza feed."
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1038451665598-mepu68bedfm5e121030iqjjgf4r9vh4v"
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "react-native-share",
        {
          "ios": [
            "instagram-stories",
            "instagram"
          ],
          "android": [
            "com.instagram.android"
          ]
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "",
          "androidGoogleMapsApiKey": ""
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Postervia shows your calendar events inside its own calendar. They stay on this device and are never uploaded."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f8713ef-dc8c-4a4d-b780-0817b299093b"
      }
    },
    "owner": "lisumchen"
  }
}
